# Base de données
POSTGRES_DB=mobility_dev
POSTGRES_USER=mobility
POSTGRES_PASSWORD=change_me_in_production

# Django
SECRET_KEY=change_me_in_production_use_django_get_random_secret_key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Authentification CAS / JWT (obligatoires en production — pas de valeur par
# défaut : un oubli doit faire échouer le démarrage plutôt que de signer/
# chiffrer silencieusement avec une clé connue publiquement).
JWT_SECRET_KEY=change_me_in_production_use_a_random_64_char_secret
JWT_EXPIRY_MINUTES=15
PGCRYPTO_KEY=change_me_in_production_min_32_characters
CAS_SERVER_PUBLIC_URL=https://cas.toulouse-inp.fr
CAS_SERVER_INTERNAL_URL=https://cas.toulouse-inp.fr
BACKEND_PUBLIC_URL=https://mobility.enseeiht.fr
FRONTEND_PUBLIC_URL=https://mobility.enseeiht.fr

# MinIO
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=change_me_in_production
MINIO_ENDPOINT=minio:9000

# APIs externes
MOVEON_API_URL=https://api.moveon.com/v1
MOVEON_API_KEY=
PEGASE_API_URL=
PEGASE_API_KEY=
EUDONET_API_URL=
EUDONET_API_KEY=

# Sentry
SENTRY_DSN=

# Nginx
NGINX_HOST=mobility.enseeiht.fr


SONAR_TOKEN=token_exemple